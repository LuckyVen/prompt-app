# ==============================================
# PROMPT. BACKEND PRODUCTION ENVIRONMENT
# ==============================================

NODE_ENV=production

# Most hosting providers assign PORT automatically.
PORT=5000

# Actual deployed frontend origin.
FRONTEND_URL=https://example.com

# ==============================================
# AUTHENTICATION
# ==============================================

JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_ISSUER=prompt-api
JWT_AUDIENCE=prompt-web

# ==============================================
# OPENAI
# ==============================================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# ==============================================
# PRODUCTION DATABASE
# ==============================================

DATABASE_URL=

# Most managed PostgreSQL services use SSL.
# Follow the actual hosting provider's requirements.
DATABASE_SSL=true

# Keep this true unless the database provider
# explicitly requires otherwise.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000